.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #ffffff;
}

.state {
  padding: 160rpx 40rpx;
  text-align: center;
  color: #999999;
  font-size: 28rpx;
}

.state-text {
  display: block;
}

.retry {
  display: inline-block;
  margin-top: 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  color: #1677ff;
  font-size: 28rpx;
}

.product {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 32rpx 40rpx;
}

.cover {
  width: 176rpx;
  height: 176rpx;
  border-radius: 12rpx;
  background: #eef3f9;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
}

.meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.3;
}

.price {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
  line-height: 1.3;
}

.rows {
  padding: 0 32rpx 48rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 0;
  border-top: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  line-height: 1.45;
}

.label {
  flex-shrink: 0;
  color: #999999;
  margin-right: 32rpx;
}

.value {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: #111111;
  word-break: break-all;
}
