<view class="page">
  <view class="hint">仅开发环境可用：输入合法手机号即可登录；未注册将自动注册。</view>

  <view class="form">
    <view class="field">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        placeholder-class="ph"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
  </view>

  <button
    class="login-btn"
    loading="{{loading}}"
    disabled="{{loading}}"
    bindtap="onLogin"
  >登录</button>
</view>
