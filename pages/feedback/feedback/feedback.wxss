.page-scroll {
  height: 100vh;
  background: #ffffff;
  box-sizing: border-box;
}

/** 首屏整页高度；历史入口在其下方，轻滚即可看到 */
.screen {
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 40rpx calc(148rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.history-wrap {
  text-align: center;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #bfbfbf;
  padding: 24rpx 24rpx calc(24rpx + 148rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 48rpx;
}

.label-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.label-row.between {
  justify-content: space-between;
}

.label {
  font-size: 30rpx;
  color: #111111;
  font-weight: 500;
}

.req {
  margin-left: 4rpx;
  font-size: 30rpx;
  color: #ff4d4f;
}

.hint {
  font-size: 26rpx;
  color: #bfbfbf;
}

.cats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 20rpx;
  margin-bottom: 28rpx;
}

.cat {
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
  background: #f5f5f5;
  line-height: 1.4;
}

.cat-on {
  color: #1677ff;
  background: #e8f3ff;
}

.textarea-wrap {
  position: relative;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx 24rpx 48rpx;
  min-height: 240rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #111111;
  line-height: 1.5;
}

.ph {
  color: #bfbfbf;
}

.count {
  position: absolute;
  right: 24rpx;
  bottom: 16rpx;
  font-size: 24rpx;
  color: #bfbfbf;
}

.shots {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.shot {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  background: #f5f5f5;
}

.shot-img {
  width: 100%;
  height: 100%;
  display: block;
}

.shot-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 0 12rpx 0 12rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
}

.shot-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d9d9d9;
  box-sizing: border-box;
  background: #fafafa;
}

.plus {
  font-size: 56rpx;
  color: #bfbfbf;
  line-height: 1;
  font-weight: 300;
}

.contact {
  padding-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.contact .label {
  display: block;
  margin-bottom: 16rpx;
}

.phone-input {
  height: 72rpx;
  font-size: 28rpx;
  color: #111111;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}

.submit {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.submit::after {
  border: none;
}

.submit[disabled] {
  opacity: 0.65;
}
