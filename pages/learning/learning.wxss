.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  box-sizing: border-box;
}

.search-wrap {
  padding: 16rpx 32rpx 8rpx;
  flex-shrink: 0;
}

.search-box {
  height: 72rpx;
  border-radius: 36rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.search-icon {
  font-size: 32rpx;
  color: #bfbfbf;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #111111;
}

.search-ph {
  color: #bfbfbf;
}

.tabs {
  display: flex;
  height: 88rpx;
  padding: 0 48rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.tab {
  position: relative;
  margin-right: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #595959;
  height: 88rpx;
}

.tab.active {
  color: #1677ff;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #1677ff;
}

.scroll {
  flex: 1;
  height: 0;
}

.empty {
  padding: 120rpx 32rpx;
  text-align: center;
  color: #bfbfbf;
  font-size: 28rpx;
}

.item {
  display: flex;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cover-wrap {
  position: relative;
  width: 220rpx;
  height: 148rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: #e6f0ff;
}

.cover {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-tag {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 28rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.item-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.course-meta {
  justify-content: space-between;
}

.sub-title {
  font-size: 24rpx;
  color: #8c8c8c;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.dot.living {
  background: #52c41a;
}

.dot.ended {
  background: #bfbfbf;
}

.status {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-right: 16rpx;
}

.living-text {
  color: #52c41a;
}

.time {
  font-size: 24rpx;
  color: #8c8c8c;
  flex-shrink: 0;
}

.hint {
  text-align: center;
  font-size: 22rpx;
  color: #bfbfbf;
  padding: 24rpx 0 48rpx;
}
