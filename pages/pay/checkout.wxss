.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f5f7fb;
  color: #1f2329;
}

.risk-banner {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: #e8f8ef;
}

.risk-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #22c55e;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.risk-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a9f4b;
}

.body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 128rpx 32rpx;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  border: 4rpx solid #d5dbe6;
  border-top-color: #8a9199;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.state-text {
  font-size: 28rpx;
  color: #8a9199;
}

.error {
  font-size: 26rpx;
  color: #f5222d;
  text-align: center;
}

.error.inline {
  display: block;
  margin-top: 24rpx;
  text-align: left;
}

.retry {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  border: 0;
  border-radius: 16rpx;
  background: #2f6bff;
  color: #ffffff;
  font-size: 28rpx;
}

.retry::after {
  border: 0;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  overflow: hidden;
}

.product {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  padding: 28rpx 28rpx 24rpx;
}

.cover {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #eef1f6;
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b7c0;
  font-size: 28rpx;
}

.product-name {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.45;
  color: #1f2329;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.kv {
  border-top: 1rpx solid #f0f2f5;
  padding: 4rpx 28rpx 12rpx;
}

.kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 80rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.kv-row:last-child {
  border-bottom: 0;
}

.kv-label {
  flex: none;
  font-size: 26rpx;
  color: #8a9199;
}

.kv-value {
  min-width: 0;
  font-size: 26rpx;
  color: #1f2329;
  text-align: right;
  word-break: break-all;
}

.kv-money {
  display: flex;
  align-items: baseline;
  color: #1f2329;
  font-weight: 700;
}

.yen {
  font-size: 26rpx;
  margin-right: 2rpx;
}

.int {
  font-size: 36rpx;
}

.dec {
  font-size: 26rpx;
}

.section-label {
  margin: 32rpx 8rpx 16rpx;
  font-size: 26rpx;
  color: #8a9199;
}

.methods {
  padding: 0 28rpx;
}

.method {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 104rpx;
}

.method-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.method-divider {
  border-top: 1rpx solid #f0f2f5;
}

.method-logo {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
}

.method-name {
  font-size: 30rpx;
  color: #1f2329;
}

.radio {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  border: 3rpx solid #c9cdd6;
  box-sizing: border-box;
  position: relative;
}

.radio.on {
  border-color: #2f6bff;
  background: #2f6bff;
}

.radio.on::after {
  content: '';
  position: absolute;
  inset: 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.agree {
  margin-top: 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 0 8rpx;
}

.agree-box {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  border-radius: 999rpx;
  border: 3rpx solid #c9cdd6;
  box-sizing: border-box;
  position: relative;
}

.agree-box.on {
  border-color: #2f6bff;
  background: #2f6bff;
}

.agree-box.on::after {
  content: '';
  position: absolute;
  inset: 8rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8a9199;
}

.link {
  color: #2f6bff;
}

.foot {
  flex: none;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border: 0;
  border-radius: 20rpx;
  background: #2f6bff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.primary::after {
  border: 0;
}

.primary.disabled,
.primary[disabled] {
  opacity: 0.45;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.45);
}

.modal-panel {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-title {
  display: block;
  padding: 40rpx 40rpx 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
}

.modal-body {
  display: block;
  padding: 0 40rpx 36rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #646a73;
  text-align: center;
}

.modal-actions {
  display: flex;
  border-top: 1rpx solid #eef0f3;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
}

.modal-btn.cancel {
  color: #8a9199;
  border-right: 1rpx solid #eef0f3;
}

.modal-btn.confirm {
  color: #2f6bff;
  font-weight: 500;
}
