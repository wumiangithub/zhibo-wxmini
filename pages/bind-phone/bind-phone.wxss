.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #ffffff;
  padding: 32rpx 32rpx 48rpx;
}

.hint {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 36rpx;
  margin-bottom: 40rpx;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.field {
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
}

.label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  color: #111111;
}

.input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  font-size: 30rpx;
  color: #111111;
}

.code-input {
  margin-right: 16rpx;
}

.ph {
  color: #bfbfbf;
}

.code-btn {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #8c8c8c;
  padding-left: 16rpx;
  border-left: 1rpx solid #eeeeee;
  line-height: 40rpx;
}

.code-btn.disabled {
  color: #bfbfbf;
}

.bind-btn {
  padding: 0;
  margin-top: 64rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.bind-btn::after {
  border: none;
}

button[disabled].bind-btn {
  background: #91bfff;
  color: #ffffff;
}
