<view class="page">
  <view class="hint">绑定后可用于登录、观看您拥有权益的直播/课程</view>

  <view class="form">
    <view class="field">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        placeholder-class="ph"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
    <view class="field">
      <text class="label">验证码</text>
      <input
        class="input code-input"
        type="number"
        maxlength="6"
        placeholder="请输入验证码"
        placeholder-class="ph"
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <view
        class="code-btn {{countdown > 0 ? 'disabled' : ''}}"
        bindtap="onGetCode"
      >{{countdown > 0 ? countdown + 's' : '获取验证码'}}</view>
    </view>
  </view>

  <button
    class="bind-btn"
    loading="{{loading}}"
    disabled="{{loading}}"
    bindtap="onBind"
  >绑定</button>
</view>
