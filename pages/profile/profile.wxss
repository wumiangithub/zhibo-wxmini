.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 72rpx 48rpx 80rpx;
  background: #ffffff;
}

.avatar-wrap {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 72rpx;
  position: relative;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #e6f0ff;
  display: block;
}

.camera-badge {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(22, 119, 255, 0.35);
  overflow: hidden;
}

.camera-icon {
  width: 56rpx;
  height: 56rpx;
}

.nick-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 8rpx;
}

.nick-label {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  color: #111111;
}

.nick-input {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 30rpx;
  color: #111111;
  height: 64rpx;
  line-height: 64rpx;
}

.nick-count {
  width: 88rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 26rpx;
  color: #bfbfbf;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 0 8rpx 64rpx;
}

.save {
  padding: 0;
  margin-top: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.save::after {
  border: none;
}

.save[disabled] {
  opacity: 0.7;
}
