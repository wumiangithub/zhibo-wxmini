<view class="page">
  <view class="profile">
    <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
    <view class="profile-main" bindtap="onTapProfile">
      <view class="nickname">{{displayName}}</view>
      <view class="profile-link">
        <text>个人信息</text>
        <text class="chev">›</text>
      </view>
    </view>
  </view>

  <view class="order-banner" bindtap="onTapOrders">
    <text class="order-text">全部订单</text>
    <image class="order-icon" src="/images/icon-order.png" mode="aspectFit"></image>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="onTapLearning">
      <text class="menu-label">我的学习</text>
      <text class="chev">›</text>
    </view>
    <view class="menu-item" bindtap="onTapPhone">
      <text class="menu-label">绑定手机号</text>
      <view class="menu-right">
        <text class="menu-value">{{phoneMasked}}</text>
        <text class="chev">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="onTapAgreement">
      <text class="menu-label">服务协议</text>
      <text class="chev">›</text>
    </view>
    <view class="menu-item" bindtap="onTapFeedback">
      <text class="menu-label">意见反馈</text>
      <text class="chev">›</text>
    </view>
    <view class="menu-item last" bindtap="onTapHotline">
      <text class="menu-label">客服热线</text>
      <text class="menu-value hotline">{{hotline}}</text>
    </view>
  </view>

  <view class="logout-wrap">
    <button class="logout" bindtap="onLogout">退出登录</button>
  </view>
</view>
