.page {
  min-height: 100vh;
  padding: 64rpx 48rpx;
  box-sizing: border-box;
  background: #f5f7fa;
}
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 64rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.06);
}
.status {
  font-size: 28rpx;
  color: #07c160;
  margin-bottom: 24rpx;
}
.name {
  font-size: 40rpx;
  font-weight: 600;
  color: #111111;
  margin-bottom: 64rpx;
}
.logout {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1677ff;
  border: 2rpx solid #1677ff;
  font-size: 28rpx;
}
.logout::after {
  border: none;
}
