.page {
  min-height: 100vh;
  padding: 32rpx 40rpx 80rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
  line-height: 1.45;
  margin-bottom: 24rpx;
}

.meta {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 34rpx;
  margin-bottom: 40rpx;
}

.meta-gap {
  margin-left: 16rpx;
}

.body-text {
  font-size: 30rpx;
  line-height: 1.85;
  color: #262626;
  word-break: break-word;
}
